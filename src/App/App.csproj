<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>false</UseWPF>
    <Nullable>enable</Nullable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>snoopwpfcli</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta5.25306.1" />
    <PackageReference Include="System.Management" Version="9.0.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WpfInspector\WpfInspector.csproj" />
    <ProjectReference Include="..\..\snoopwpf\Snoop.InjectorLauncher\Snoop.InjectorLauncher.csproj" />
  </ItemGroup>

  <!-- Copy x64 and ARM64 InjectorLauncher executables to output directory -->
  <Target Name="CopyInjectorLaunchers" AfterTargets="Build;Publish">
    <PropertyGroup>
      <InjectorOutputDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\snoopwpf\bin\$(Configuration)'))</InjectorOutputDir>
      <InjectorOutputDirDebug>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\snoopwpf\bin\Debug'))</InjectorOutputDirDebug>
      <CopyDestination Condition="'$(PublishDir)' != ''">$(PublishDir)</CopyDestination>
      <CopyDestination Condition="'$(PublishDir)' == ''">$(OutputPath)</CopyDestination>
    </PropertyGroup>
    <ItemGroup>
      <InjectorFiles Include="$(InjectorOutputDir)\Snoop.InjectorLauncher.x64.*" />
      <InjectorFiles Include="$(InjectorOutputDir)\Snoop.InjectorLauncher.ARM64.*" />
      <!-- GenericInjector: use Configuration dir if available, fallback to Debug (C++ native DLL, Debug build only) -->
      <InjectorFiles Include="$(InjectorOutputDir)\Snoop.GenericInjector.x64.dll"
                     Condition="Exists('$(InjectorOutputDir)\Snoop.GenericInjector.x64.dll')" />
      <InjectorFiles Include="$(InjectorOutputDirDebug)\Snoop.GenericInjector.x64.dll"
                     Condition="!Exists('$(InjectorOutputDir)\Snoop.GenericInjector.x64.dll')" />
      <InjectorFiles Include="$(InjectorOutputDir)\Snoop.GenericInjector.x86.dll"
                     Condition="Exists('$(InjectorOutputDir)\Snoop.GenericInjector.x86.dll')" />
      <InjectorFiles Include="$(InjectorOutputDirDebug)\Snoop.GenericInjector.x86.dll"
                     Condition="!Exists('$(InjectorOutputDir)\Snoop.GenericInjector.x86.dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(InjectorFiles)" DestinationFolder="$(CopyDestination)" SkipUnchangedFiles="true" Condition="'@(InjectorFiles)' != ''" />
  </Target>

</Project>
